eval(id, [X], X).

eval(not, [true], false).
eval(not, [false], true).

eval(or, [true, X], true) :- bool(X).
eval(or, [false, X], X) :- bool(X).

eval(and, [true, X], X) :- bool(X).
eval(and, [false, X], false) :- bool(X).

eval(xor, [true, true], false).
eval(xor, [true, false], true).
eval(xor, [false, true], true).
eval(xor, [false, false], false).

eval(pred, [suc(X)], X) :- nat(X).

bool(true).
bool(false).

nat(zero).
nat(suc(X)) :- nat(X).

eval(fold, [_, A, []], A).
eval(fold, [F, A, [H|T]], R) :-
    eval(F, [A,H], C),
    eval(fold, [F, C, T], R).

eval(map, [_, []], []).
eval(map, [F, [H|T]], [HR|TR]) :-
    eval(F, [H], HR),
    eval(map, [F, T], TR).
