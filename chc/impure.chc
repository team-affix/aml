% ============================================================
% Impure Lambda Calculus — CBV Normalization by Evaluation
%
% Term formers:
%   var(N)        -- de Bruijn (Peano; var(zero) = innermost)
%   abs(B)        -- abstraction
%   app(F, A)     -- application
%   global(Name)  -- declared name (not, suc, or, plus, if)
%   data(C)       -- constructor data (true, false, zero, suc(N))
%
% data(C) wraps a whole constructor term once, never per layer:
% data(suc(suc(zero))), not data(suc(data(zero))). The wrapper is
% there so that every term former is a distinct functor and eval
% never has to guess which clause applies. It is worth roughly 3x
% on evaluation against an unwrapped, variable-headed data clause,
% at the cost of a few percent on synthesis and one extra node per
% data leaf. Values stay unwrapped, so con/1 and delta/3 keep
% seeing raw constructors and the domain section is unaffected.
%
% A name with arity >= 1 is applied as global(Name). Constructors
% are names too: suc : nat -> nat, so suc has an arity and an
% intro rule, exactly as in Agda. So suc has two spellings --
% data(suc(zero)) when its argument is already data, and
% app(global(suc), X) when it is not. The second is what lets
% abs(app(global(suc), var(zero))) be lambda n. suc n and
% normalize to itself.
%
% Public API:
%   normalize(Term, Result)
%   fits(M, Inputs, Labels)
%     Row i applies M to Inputs_i and reifies to Labels_i.
%     M is evaluated once and the value reused across rows.
%   fits_data(M, Inputs, Labels)
%     fits/3 with every element of every input row, and every
%     label, wrapped in data/1 for you -- write bare constructors
%     and drop the noise. Only for all-data tables: it cannot
%     express a function input like global(not) or a non-data
%     label like abs(...). Use fits/3 directly for those.
%   fits_nf(M, Inputs, Labels)
%     Same, but M is restricted to closed beta-normal terms.
%     Slower to the first answer, but every answer is a distinct
%     meaningful program: no beta-redexes, no dead subterms.
%   prog(M)   -- closed beta-normal M
%
% No bounds. Nothing here limits evaluation. Normalization depth
% is unrestricted: output may nest arbitrarily deep, application
% spines may be arbitrarily long, and delta may recurse as far as
% it likes. prog/1 generates programs of any size. The only limit
% is the solver's --max-resolutions, which bounds time.
%
% One consequence: a divergent term does not fail. Both
% app(abs(app(var(zero), var(zero))), abs(app(var(zero), var(zero))))
% and the Y combinator run until --max-resolutions truncates the
% rollout, so REFUTED under a low cap is a statement about the
% budget, not about the term.
%
% Extending: declare sorts, con/1, arity/2, delta/3. Never
% eval/3, apply/3, reify/3. Helpers (add/3) are yours.
%
%   bool(true).
%   con(true).
%   arity(or, suc(suc(zero))).
%   delta(or, [true, Y], true) :- bool(Y).
%
% con/1 means "is data at all", independent of sort. Terms are
% discriminated by functor, but values are not wrapped, so the
% kernel still uses con/1 to tell data from closures and stuck
% spines in apply. Keep its clauses rigid (one per
% constructor). Do not write
% con(X) :- bool(X) -- a variable head cannot be discriminated
% during synthesis and costs an order of magnitude.
%
% Guard every delta argument with the sort that position wants,
% not with con: or true zero must not reduce. Do not return
% var(...) from delta -- that would be a dangling index; the
% kernel's con(R) check rejects it.
%
% Example queries:
%
%   normalize(app(global(not), data(true)), R)           % R = data(false)
%   normalize(app(app(global(or), data(true)), data(false)), R)
%                                                        % R = data(true)
%   normalize(app(app(global(plus), data(suc(zero))), data(suc(zero))), R)
%                                                    % R = data(suc(suc(zero)))
%   normalize(app(app(app(global(if), data(true)), data(zero)),
%             data(suc(zero))), R)                       % R = data(zero)
%   normalize(abs(app(global(suc), var(zero))), R)       % R = itself
%   normalize(app(global(not), abs(var(zero))), R)       % R = itself (stuck)
%
%   fits(M, [[data(true)], [data(false)]],
%        [data(false), data(true)])                      % M = global(not)
%   fits(M, [[data(true), data(false)], [data(false), data(false)],
%            [data(false), data(true)], [data(true), data(true)]],
%        [data(true), data(false), data(true), data(true)])
%                                                        % M = global(or)
%   fits(M, [[data(zero), data(suc(zero))],
%            [data(suc(zero)), data(suc(zero))]],
%        [data(suc(zero)), data(suc(suc(zero)))])        % M = global(plus)
%
%   % the same three tables via fits_data, wrapping done for you:
%   fits_data(M, [[true], [false]], [false, true])       % M = global(not)
%   fits_data(M, [[true, false], [false, false],
%                 [false, true], [true, true]],
%             [true, false, true, true])                 % M = global(or)
%   fits_data(M, [[zero, suc(zero)], [suc(zero), suc(zero)]],
%             [suc(zero), suc(suc(zero))])               % M = global(plus)
%
% Runtime-only values: clo(Body, Env), pap(Name, RevArgs, Left),
% sp(Head, RevArgs) where Head is fvar(Level) or gl(Name),
% fvar(Level), env(Val, Outer), nil. Data values are bare
% constructors -- data(C) is a term former only, stripped by eval
% and reapplied by reify. A stuck application is an
% sp, never an app, which is what keeps derivations unique.
% Argument lists are closed so a value stays reusable.
%
% The Peano numerals inside pap are the remaining-argument count
% from arity/2, not a budget: they are what makes "still
% collecting" and "saturated, run delta" mutually exclusive.
% ============================================================

% ============================================================
% Kernel
% ============================================================

eval(var(N), env(V, E), R) :- lookup(N, env(V, E), R).
eval(abs(B), E, clo(B, E)).
eval(app(F, A), E, R) :- eval(F, E, FV), eval(A, E, AV), apply(FV, AV, R).
eval(global(N), _, pap(N, [], K)) :- arity(N, K).
eval(data(C), _, C) :- con(C).

lookup(zero, env(V, _), V).
lookup(suc(N), env(_, E), R) :- lookup(N, E, R).

apply(clo(B, E), V, R) :- eval(B, env(V, E), R).
apply(pap(F, As, suc(suc(K))), V, pap(F, [V|As], suc(K))) :- con(V).
apply(pap(F, As, suc(zero)), V, R) :-
    con(V),
    rev([V|As], Args),
    delta(F, Args, R),
    con(R).
apply(pap(F, As, _), V, sp(gl(F), [V|As])) :- nondata(V).
apply(sp(H, As), V, sp(H, [V|As])).
apply(fvar(L), V, sp(fvar(L), [V])).

reify(clo(B, E), L, abs(R)) :-
    eval(B, env(fvar(L), E), BV),
    reify(BV, suc(L), R).
reify(fvar(L), Level, var(I)) :- level_to_idx(L, Level, I).
reify(pap(F, As, _), L, T) :- reify_spine(global(F), As, L, T).
reify(sp(gl(F), As), L, T) :- reify_spine(global(F), As, L, T).
reify(sp(fvar(L0), As), L, T) :-
    level_to_idx(L0, L, I),
    reify_spine(var(I), As, L, T).
reify(V, _, data(V)) :- con(V).

reify_spine(H, [], _, H).
reify_spine(H, [A|As], L, app(T, RA)) :-
    reify_spine(H, As, L, T),
    reify(A, L, RA).

level_to_idx(L, suc(L), zero).
level_to_idx(L, suc(N), suc(I)) :- level_to_idx(L, N, I).

nondata(clo(_, _)).
nondata(pap(_, _, _)).
nondata(sp(_, _)).
nondata(fvar(_)).

rev(L, R) :- rev_acc(L, [], R).
rev_acc([], A, A).
rev_acc([H|T], A, R) :- rev_acc(T, [H|A], R).

normalize(T, R) :- eval(T, nil, V), reify(V, zero, R).

fits(M, Ins, Labs) :- eval(M, nil, MV), rows(MV, Ins, Labs).

rows(_, [], []).
rows(MV, [Args|Rest], [Y|Ys]) :-
    saturate(MV, Args, V),
    reify(V, zero, Y),
    rows(MV, Rest, Ys).

saturate(V, [], V).
saturate(F, [A|As], R) :-
    eval(A, nil, AV),
    apply(F, AV, R1),
    saturate(R1, As, R).

fits_data(M, Ins, Labs) :-
    wrap_rows(Ins, WIns),
    wrap_args(Labs, WLabs),
    fits(M, WIns, WLabs).

wrap_rows([], []).
wrap_rows([Args|Rest], [WArgs|WRest]) :-
    wrap_args(Args, WArgs),
    wrap_rows(Rest, WRest).

wrap_args([], []).
wrap_args([C|Cs], [data(C)|Ws]) :- wrap_args(Cs, Ws).

% ============================================================
% Closed beta-normal programs
%
% The D argument is de Bruijn scope, not a budget: it counts the
% enclosing lambdas so lt/2 can reject an out-of-scope index.
% ============================================================

nf(abs(B), D) :- nf(B, suc(D)).
nf(data(C), _) :- con(C).
nf(X, D) :- ne(X, D).

ne(var(I), D) :- lt(I, D).
ne(global(N), _) :- arity(N, _).
ne(app(F, A), D) :- ne(F, D), nf(A, D).

lt(zero, suc(_)).
lt(suc(I), suc(D)) :- lt(I, D).

prog(M) :- nf(M, zero).

fits_nf(M, Ins, Labs) :- prog(M), fits(M, Ins, Labs).

% ============================================================
% Domain
% ============================================================

bool(true).
bool(false).

nat(zero).
nat(suc(N)) :- nat(N).

con(true).
con(false).
con(zero).
con(suc(N)) :- nat(N).

arity(not,  suc(zero)).
arity(suc,  suc(zero)).
arity(or,   suc(suc(zero))).
arity(plus, suc(suc(zero))).
arity(if,   suc(suc(suc(zero)))).

delta(not,  [true],  false).
delta(not,  [false], true).
delta(suc,  [X], suc(X))      :- nat(X).
delta(or,   [true,  Y], true) :- bool(Y).
delta(or,   [false, Y], Y)    :- bool(Y).
delta(plus, [X, Y], R)        :- add(X, Y, R).
delta(if,   [true,  T, E], T) :- con(T), con(E).
delta(if,   [false, T, E], E) :- con(T), con(E).

add(zero,   Y, Y)      :- nat(Y).
add(suc(X), Y, suc(R)) :- add(X, Y, R).

eq(X, X).
