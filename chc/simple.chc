eval(id, [X], X).

eval(not, [true], false).
eval(not, [false], true).

eval(or, [true, X], true) :- bool(X).
eval(or, [false, X], X) :- bool(X).

eval(and, [true, X], X) :- bool(X).
eval(and, [false, X], false) :- bool(X).

eval(pred, [suc(X)], X).

bool(true).
bool(false).

nat(zero).
nat(suc(X)) :- nat(X).

eval(true, [], true).
eval(false, [], false).

eval(zero, [], zero).
eval(suc(X), [], suc(X)) :- nat(X).

norm(E, intro(Exp,Arg), R) :-
    norm(E, Arg, NArg),
    norm([NArg|E], Exp, R).

norm(E, var(X), R) :-
    lookup(E, X, R).

norm(E, compose(F,Args), R) :-
    norm_all(E, Args, NArgs),
    eval(F, NArgs, R).

lookup([V|Rest],zero,V).
lookup([_|Rest],suc(X),Y) :- lookup(Rest,X,Y).

norm_all(_, [], []).
norm_all(E, [H|T], [NH|NT]) :-
    norm(E, H, NH),
    norm_all(E, T, NT).
