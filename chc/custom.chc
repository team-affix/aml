% ============================================================
% custom.chc — NbE kernel with built-in pattern matching
%
% Term language:
%   var(N)           de Bruijn index
%   lam(B)           lambda, body B
%   app(F, A)        application
%   o(C)             opaque constructor atom
%   t(F)             transparent named function (has a def/2 clause)
%   switch(P, T, El) arity-1 match: pattern P, then T, else El
%   fresh            wildcard in a pattern — introduces one binding
%   fail             explicit failure (legal only as El)
%
% Value language (runtime only):
%   lam(B, E)        closure
%   o(C)             opaque constructor
%   app(F, V)        firm application — head is o/sw/lam/app
%   nap(F, V)        neutral application — head is fvar or nap
%   sw(P,T,El,E)     suspended switch waiting for its argument
%   fvar(L)          free variable at de Bruijn level L
%
% app vs nap: neutrality is embedded at construction time so the neutral/1
% check in apply is O(1) — no recursive head-spine scan required.
%
% switch(P, T, El) applied to V:
%   - if neutral(V): stay stuck as nap(sw(...), V)
%   - if pm(V, P, Binds) succeeds: eval T with Binds extending env
%   - if pm_fail(V, P): reduce El; if El = fail, conflict terminates branch
%
% Neutrality is a property of V alone, independent of P. Any switch applied
% to a neutral argument is stuck — including switch(fresh, ...). We wait
% for the argument to reach a known head (WHNF) before firing. Reducing
% under an unknown is wasted work: the outer variable must be given an
% opaque value first, at which point the switch unblocks naturally.
%
% switch/3 is ternary to allow nesting:
%   switch(P1, T1, switch(P2, T2, fail))
%
% map =
%   lam(lam(switch(
%       o(nil), o(nil),
%       switch(
%           app(app(o(cons), fresh), fresh),
%           app(app(o(cons), app(var(suc(suc(zero))), var(suc(zero)))),
%                           app(app(t(map), var(suc(suc(zero)))), var(zero))),
%           fail
%       )
%   )))
%
% Outer lam binds F (de Bruijn index suc(suc(zero)) inside the body).
% The switch matches L: nil -> nil; cons H T -> cons (F H) (map F T).
% ============================================================

% ============================================================
% Constructor identity — used by pm and pm_fail to compare
% constructor heads without relying on Prolog unification.
% Add one id/2 clause per constructor in the domain.
% ============================================================

id(zero, zero).
id(suc,  suc(zero)).
id(nil,  suc(suc(zero))).
id(cons, suc(suc(suc(zero)))).

id_neq(zero,   suc(_)).
id_neq(suc(_), zero).
id_neq(suc(X), suc(Y)) :- id_neq(X, Y).

eq(X, Y)  :- id(X, T), id(Y, T).
neq(X, Y) :- id(X, T1), id(Y, T2), id_neq(T1, T2).

% ============================================================
% Pattern matching
%
% pm(Value, Pattern, Binds)
%   Succeeds when Value matches Pattern.
%   Binds is a list of values captured by fresh sub-patterns,
%   left-to-right as they appear in the pattern.
%
% pm_fail(Value, Pattern)
%   Succeeds when Value definitely cannot match Pattern —
%   constructor heads provably differ, or shapes are incompatible.
%   pm and pm_fail are mutually exclusive on firm values.
% ============================================================

append([], Ys, Ys).
append([X|Xs], Ys, [X|Zs]) :- append(Xs, Ys, Zs).

pm(V,          fresh,      [V]).
pm(o(C),       o(C),       []).
pm(app(A,B),   app(P,Q),   Binds) :-
    pm(A, P, B1), pm(B, Q, B2), append(B1, B2, Binds).

pm_fail(o(C),        o(D))        :- neq(C, D).
pm_fail(o(_),        app(_, _)).
pm_fail(app(_, _),   o(_)).
pm_fail(app(A, _),   app(P, _))   :- pm_fail(A, P).
pm_fail(app(A, B),   app(P, Q))   :- pm(A, P, _), pm_fail(B, Q).
pm_fail(lam(_, _),   o(_)).
pm_fail(lam(_, _),   app(_, _)).

% neutral/1 — a value is neutral when its head cannot be decided without
% more information. Neutrality is a property of the value alone.
neutral(fvar(_)).
neutral(nap(_, _)).
neutral(sw(_, _, _, _)).

% ============================================================
% Kernel
% ============================================================

% eval/3 — call-by-value: both sides of app are evaluated before apply.

eval(var(N),        E, V) :- lookup(N, E, V).
eval(lam(B),        E, lam(B, E)).
eval(o(C),          _, o(C)).
eval(t(F),          _, V) :- def(F, Body), eval(Body, nil, V).
eval(app(F, A),     E, R) :- eval(F, E, FV), eval(A, E, AV), apply(FV, AV, R).
eval(switch(P,T,El),E, sw(P, T, El, E)).

% apply/3
%
% app(F, V)  — firm application: head is o(C), sw, lam, or firm app.
% nap(F, V)  — neutral application: head is fvar or neutral nap.
% Neutrality is tagged at construction time so switch can check it
% in O(1) by pattern matching on the outermost constructor.

apply(lam(B, E),    V, R)              :- eval(B, env(V, E), R).
apply(sw(P,T,El,E), V, nap(sw(P,T,El,E), V)) :- neutral(V).
apply(sw(P,T,El,E), V, R)              :- pm(V, P, Binds), eval_with(T, E, Binds, R).
apply(sw(P,T,El,E), V, R)              :- pm_fail(V, P), eval(El, E, SW), apply(SW, V, R).
apply(o(C),              V, app(o(C), V)).
apply(fvar(L),           V, nap(fvar(L), V)).
apply(app(F, A),         V, app(app(F, A), V)).
apply(nap(F, A),         V, nap(nap(F, A), V)).

% eval(fail, …) has no clause — applying a switch whose El is fail
% and whose pattern definitively does not match produces a conflict,
% which the solver interprets as a dead branch and terminates it.

lookup(zero,   env(V, _), V).
lookup(suc(N), env(_, E), V) :- lookup(N, E, V).

eval_with(T, E, [],     R) :- eval(T, E, R).
eval_with(T, E, [V|Vs], R) :- eval_with(T, env(V, E), Vs, R).

% ============================================================
% Reify — convert a value back to a term.
% L is the current lambda depth (a Peano nat), used to name
% fresh variables introduced under binders.
% ============================================================

reify(lam(B, E),    L, lam(R)) :-
    eval(B, env(fvar(L), E), BV),
    reify(BV, suc(L), R).
reify(o(C),         _, o(C)).
reify(sw(P,T,El,_), _, switch(P, T, El)).
reify(app(F, V),    L, app(RF, RV)) :- reify(F, L, RF), reify(V, L, RV).
reify(nap(F, V),    L, app(RF, RV)) :- reify(F, L, RF), reify(V, L, RV).
reify(fvar(L0),     L, var(I))      :- level_to_idx(L0, L, I).

level_to_idx(L,    suc(L), zero).
level_to_idx(L,    suc(N), suc(I)) :- level_to_idx(L, N, I).

% ============================================================
% Public
% ============================================================

normalize(T, R) :- eval(T, nil, V), reify(V, zero, R).

% ============================================================
% Domain: named functions
%
% def(Name, Body) — Body is a term (chain of lam / switch).
% eval(t(Name), _, V) evaluates Body in the empty environment.
% ============================================================

% map : (A -> B) -> List A -> List B
%
% One lam binds F. switch is itself arity-1 and binds L implicitly.
% Inside the then-branch of the cons case, after eval_with pushes
% the two fresh bindings onto the env:
%   var(zero)         = T  (tail, rightmost fresh)
%   var(suc(zero))    = H  (head, leftmost fresh)
%   var(suc(suc(zero))) = F  (from the outer env)
def(map,
    lam(switch(
        o(nil),
        o(nil),
        switch(
            app(app(o(cons), fresh), fresh),
            app(app(o(cons), app(var(suc(suc(zero))), var(suc(zero)))),
                             app(app(t(map), var(suc(suc(zero)))), var(zero))),
            fail
        )
    ))).
